# ========================
# Root-level .gitignore
# ========================

# Dependencies
node_modules/

# Environment files (NEVER commit these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Vercel
.vercel
